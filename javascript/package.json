{
  "name": "@crawlora-org/reelshort",
  "version": "0.1.0",
  "description": "Crawlora ReelShort API client with 11 endpoints for title discovery, search, movie details, new releases, and public Fandom articles",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=reelshort-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-reelshort/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "reelshort", "reelshort-api", "reelshort-scraper", "reelshort-data", "reelshort-title-discovery", "reelshort-search", "reelshort-movie-details", "reelshort-new-releases", "reelshort-public-fandom-articles"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-reelshort",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
