  "info": {
    "contact": {
      "email": "support@crawlora.net",
      "name": "API Support",
      "url": "https://crawlora.net"
    },
    "description": "Crawlora is a hosted web-data and SERP API: call documented REST endpoints and get normalized JSON instead of HTML to parse — across search/SERP, maps and local, e-commerce, app stores, social, media and finance. One API key; Crawlora runs the proxy rotation, headless browsers and parsing behind the scenes. Billed pay-on-success: charged only on a successful 2xx response, 1-10 credits per call, with a free tier of 2,000 credits per month and no card. A hosted MCP server (mcp.crawlora.net/mcp) exposes the same catalog as agent tools. Search endpoints accept `q` as a universal alias for whichever search-term parameter they document (`query`, `term`, `keyword`, or Amazon's `k`), so one parameter name works across the whole catalog; an explicitly supplied documented name always wins.",
    "license": {
      "name": "Crawlora Terms of Service",
      "url": "https://crawlora.net/terms"
    },
    "termsOfService": "https://crawlora.net/terms",
    "title": "Crawlora API",
    "version": "1.2",
    "x-logo": {
      "altText": "Crawlora",
      "backgroundColor": "#FFFFFF",
      "url": "https://raw.githubusercontent.com/Crawlora-org/crawlora-mcp/main/assets/logo-400x400.png"
    }
  },
  "paths": {
    "/reelshort/fandom-categories": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns the categories of ReelShort's (reelshort.com) editorial site, Fandom (cast profiles, plot write-ups, streaming guides): id, slug, name, description, number of articles and link, read live from ReelShort. Pass a category slug to reelshort-fandom-posts. Only public editorial text is read.",
        "operationId": "reelshort-fandom-categories",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/reelshort.fandomCategoriesResponseDoc"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "429": {
            "description": "Too Many Requests",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "List ReelShort Fandom's article categories",
        "tags": [
          "reelshort"
        ]
      }
    },
    "/reelshort/fandom-post": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns one article from ReelShort's (reelshort.com) editorial site, Fandom: title, excerpt, link, image, publish and modify times, category names, the full article text as plain text, and the ids of the ReelShort titles it links to (pass them to reelshort-movie). id is the article id, its slug, or its reelshort.com/fandom URL. Only public editorial text is read. An unknown article returns not found.",
        "operationId": "reelshort-fandom-post",
        "parameters": [
          {
            "description": "Article id (digits), article slug, or a reelshort.com/fandom URL",
            "in": "query",
            "name": "id",
            "required": true,
            "type": "string",
            "x-example": "54181"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/reelshort.fandomPostResponseDoc"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "429": {
            "description": "Too Many Requests",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Get a ReelShort Fandom article",
        "tags": [
          "reelshort"
        ]
      }
    },
    "/reelshort/fandom-posts": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Lists articles from ReelShort's (reelshort.com) editorial site, Fandom, newest first: id, slug, title, excerpt, link, image, publish and modify times and category names, with the total and page count. Filter by search text and by category slug (general-topic, movie-cast-list, top-movie-stories, where-to-watch or where-to-watch-2). Pass an article id to reelshort-fandom-post for its text. Only public editorial text is read.",
        "operationId": "reelshort-fandom-posts",
        "parameters": [
          {
            "description": "Text to search articles for, up to 100 characters",
            "in": "query",
            "name": "search",
            "type": "string",
            "x-example": "alpha"
          },
          {
            "description": "Category slug: general-topic, movie-cast-list, top-movie-stories, where-to-watch or where-to-watch-2",
            "enum": [
              "general-topic",
              "movie-cast-list",
              "top-movie-stories",
              "where-to-watch",
              "where-to-watch-2"
            ],
            "in": "query",
            "name": "category",
            "type": "string",
            "x-example": "movie-cast-list"
          },
          {
            "description": "Page number, 1 to 10000; defaults to 1",
            "in": "query",
            "name": "page",
            "type": "integer",
            "x-example": 2
          },
          {
            "description": "Page size, 1 to 100; defaults to 10",
            "in": "query",
            "name": "limit",
            "type": "integer",
            "x-example": 10
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/reelshort.fandomPostsResponseDoc"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "429": {
            "description": "Too Many Requests",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
