  "keywords": [
    "crawlora",
    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "reelshort",
    "reelshort-api",
    "reelshort-scraper",
    "reelshort-data",
    "reelshort-title-discovery",
    "reelshort-search",
    "reelshort-movie-details",
    "reelshort-new-releases",
    "reelshort-public-fandom-articles"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Reelshort\\": "php/src/Crawlora/Reelshort/"
    }
  },
  "autoload-dev": {
